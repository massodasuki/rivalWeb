# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rival_user
DB_PASSWORD=rival_pass
DB_DATABASE=rival_db
DB_LOGGING=error,warn,query

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h

# App
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=rival_user
RABBITMQ_PASS=rival_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
