# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=rival_user
DB_PASSWORD=rival_pass
DB_DATABASE=rival_db
DB_LOGGING=error,warn,query

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=1h

# App
PORT=3001
NODE_ENV=production

# CORS
CORS_ORIGIN=http://localhost:3000

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rival_user
RABBITMQ_PASS=rival_pass
RABBITMQ_URL=amqp://rival_user:rival_pass@rabbitmq:5672

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
