# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=rival_user
DB_PASSWORD=rival_pass
DB_DATABASE=rival_db
DB_LOGGING=error,warn
# Set to true on first run to auto-create schema; set to false after
DB_SYNC=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=production

# CORS — must match the URL you open in the browser
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# RabbitMQ
RABBITMQ_USER=rival_user
RABBITMQ_PASS=rival_pass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
