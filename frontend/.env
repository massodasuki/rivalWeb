# Backend API URL (adjust for your environment)
# For local development: leave empty to use Vite proxy (recommended)
# For Docker/Prod behind Nginx: leave empty to use same-origin + /api proxy
# Direct backend access (bypassing proxy): http://backend:3001
VITE_BACKEND_URL=

# Frontend URL (for CORS - used by backend)
# For local development: http://localhost:3000, http://localhost:5173, or http://localhost:5174
# For Docker: http://frontend:3000
VITE_FRONTEND_URL=http://localhost:5173

# API URL for HTTP requests (proxied via Vite/Nginx)
# Leave empty for local development or Docker to use same-origin + /api proxy
VITE_API_URL=
